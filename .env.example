PORT=4000
HTTPS_PORT=4443
# Hosts para el SAN del certificado autofirmado que sirve HTTPS (ver src/lib/tls.ts).
# Necesario porque el frontend en S3 se sirve por HTTPS y los navegadores bloquean
# llamadas HTTP desde ahí. Actualiza esto si cambia la IP pública/privada del BFF.
TLS_HOSTS=localhost,127.0.0.1,98.92.64.170,172.31.3.73

# URLs de los microservicios usando IP pública (para correr el BFF fuera de la VPC,
# p.ej. en local). Ajusta el puerto si el microservicio expone su API en uno distinto.
PUBLICATIONS_BASE_URL=http://100.55.98.236:8083/api/v1/publications
PRODUCTS_BASE_URL=http://34.239.255.125:8082/api/v1/products
USERS_BASE_URL=http://100.54.104.174:8081/api/v1/users
PAYMENTS_BASE_URL=http://localhost:8086/api/payments
SHIPPING_BASE_URL=http://localhost:8084/api/v1
REPORTS_BASE_URL=http://localhost:8087/api/v1

CORS_ORIGINS=https://sotom28.github.io,http://localhost:4200

CACHE_TTL_MS=300000
USER_CACHE_TTL_MS=300000
UPSTREAM_TIMEOUT_MS=5000
LOG_FILE=logs/bff.log

# IPs privadas de referencia (usar estas en la Task Definition de ECS, ya que el
# BFF correrá dentro de la misma VPC que los microservicios):
# product:     172.31.59.204
# publicacion: 172.31.72.91
# user:        172.31.72.222

# App Registration de la app (mismo que usa el frontend para el login con MSAL).
# El token se valida contra el JWKS de este tenant y debe tener aud = api://<client id>.
AZURE_TENANT_ID=35365687-614a-481c-8b8b-b4debee24880
AZURE_CLIENT_ID=6c2342af-22f6-4de8-a545-2a3b04e7d1ff

# ¿Se aceptan headers X-User-* a mano (sin Bearer token) para poder probar
# con curl? En dev queda habilitado salvo que lo pongas en false; con
# NODE_ENV=production se deshabilita siempre (ver Dockerfile).
# Con false, un request sin Authorization pierde su identidad y las rutas
# de escritura responden 401 -> por eso script/test-bff.sh y seed-data.sh
# necesitan correr en modo dev.
ALLOW_DEV_AUTH_HEADERS=true
