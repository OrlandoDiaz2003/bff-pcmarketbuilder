PORT=4000
HTTPS_PORT=4443
# Hosts para el SAN del certificado autofirmado que sirve HTTPS (ver src/lib/tls.ts).
# Necesario porque el frontend en S3 se sirve por HTTPS y los navegadores bloquean
# llamadas HTTP desde ahí. Actualiza esto si cambia la IP pública/privada del BFF.
TLS_HOSTS=localhost,127.0.0.1,18.213.192.99,172.31.3.73

# URLs de los microservicios usando IP pública (para correr el BFF fuera de la VPC,
# p.ej. en local). Ajusta el puerto si el microservicio expone su API en uno distinto.
PUBLICATIONS_BASE_URL=http://100.55.98.236:8083/api/v1/publications
PRODUCTS_BASE_URL=http://34.239.255.125:8082/api/v1/products
USERS_BASE_URL=http://100.54.104.174:8081/api/v1/users

CACHE_TTL_MS=300000
USER_CACHE_TTL_MS=300000
UPSTREAM_TIMEOUT_MS=5000
LOG_FILE=logs/bff.log

# IPs privadas de referencia (usar estas en la Task Definition de ECS, ya que el
# BFF correrá dentro de la misma VPC que los microservicios):
# product:     172.31.59.204
# publicacion: 172.31.72.91
# user:        172.31.72.222
